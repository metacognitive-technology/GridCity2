# GridCity environment names. Comments only — do not put real secrets in this file.
# Copy to .env on the host and fill in values there. Anonymous play needs none of these.

# xAI key for GridBot chat. Chat returns 503 when this is empty. Escalation does not need it.
XAI_API_KEY=

# Optional webhook GridBot calls when a message is escalated.
GRIDBOT_ESCALATE_WEBHOOK_URL=
GRIDBOT_ESCALATE_WEBHOOK_AUTH=

# Bearer token for POST /api/bot/escalate/:id/reply.
# GRIDBOT_INJECT_TOKEN is an alias. If both are empty, only an admin session can inject a reply.
GRIDBOT_ESCALATE_INJECT_TOKEN=
GRIDBOT_INJECT_TOKEN=

# Test-only. Set to 1 to make /api/bot/chat return scripted replies and skip xAI.
GRIDBOT_FAKE_LLM=

# First admin. Created only when the users table is empty. Restart never reseeds.
# GRIDCITY_ADMIN_PASSWORD is an alias of GRIDCITY_ADMIN_INITIAL_PASSWORD.
GRIDCITY_ADMIN_EMAIL=
GRIDCITY_ADMIN_NAME=
GRIDCITY_ADMIN_INITIAL_PASSWORD=
GRIDCITY_ADMIN_PASSWORD=
# Set to 0 to leave must_change_password off. Any other value requires a change at first login.
GRIDCITY_ADMIN_FORCE_CHANGE=

# Comma-separated browser origins allowed to open Socket.IO with credentials.
# Empty reflects the request origin so local dev and tests keep working.
GRIDCITY_ORIGINS=

# IANA timezone for task due dates. Defaults to America/New_York.
GRIDCITY_TZ=

# Assignee for a quick task when the creator cannot assign people.
# An email or a user id. Empty uses the oldest active admin.
QUICK_TASK_DEFAULT_ASSIGNEE=

# Toast text for a non-admin after Quick task. Defaults to: Task added.
QUICK_TASK_PLAYER_TOAST=

# Login attempts allowed per IP per 15 minutes. Defaults to 20.
GRIDCITY_LOGIN_RATE_LIMIT=

# SQLite file. Production image default is /app/data/gridcity.db.
GRIDCITY_DB=

PORT=
NODE_ENV=
